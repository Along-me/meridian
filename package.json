{
  "name": "meridian-desktop",
  "version": "1.2.1",
  "private": true,
  "description": "Meridian Windows world clock and time conversion tools",
  "author": "Along-me",
  "repository": {
    "type": "git",
    "url": "https://github.com/Along-me/meridian.git"
  },
  "homepage": "https://github.com/Along-me/meridian",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "preview": "node preview-server.cjs",
    "prepare:app": "node desktop/prepare.cjs",
    "start": "node desktop/prepare.cjs && node node_modules/electron/cli.js .",
    "test:desktop": "node desktop/prepare.cjs && node node_modules/electron/cli.js . --smoke-test",
    "test": "node scripts/test.cjs",
    "pack": "node desktop/prepare.cjs && node node_modules/electron-builder/cli.js --win --x64 --dir",
    "dist": "node desktop/prepare.cjs && node node_modules/electron-builder/cli.js --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.meridian.worldclock",
    "productName": "Meridian",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Along-me",
        "repo": "meridian",
        "releaseType": "release"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "tool-shortcuts.js",
      "desktop/main.cjs",
      "desktop/updates.cjs",
      "desktop/quick-launch.cjs",
      "desktop/currency-service.cjs",
      "desktop/widget-drag.cjs",
      "desktop/widget-geometry.cjs",
      "desktop/widget-visibility.cjs",
      "desktop/factory-defaults.json",
      "desktop/login-items.cjs",
      "desktop/preload.cjs",
      "desktop/tooltip-window.cjs",
      "desktop/tooltip-preload.cjs",
      "desktop/tooltip.html",
      "desktop/smoke.test.cjs",
      "desktop/currency-ui.test.cjs",
      "desktop/currency-sources-ui.test.cjs",
      "desktop/app.html",
      "desktop/renderer/**/*",
      "desktop/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico",
      "signExecutable": false,
      "artifactName": "Meridian-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "desktop/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meridian 时区助手",
      "uninstallDisplayName": "Meridian 时区助手",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
